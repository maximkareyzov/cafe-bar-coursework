<Window x:Class="CafeBar.Modules.MenuManagement.UI.ModifierWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Модификатор" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#F5F6F8">
	<StackPanel Margin="28,24">
		<TextBlock x:Name="HeaderText" FontSize="22" FontWeight="SemiBold" />
		<TextBlock Text="Позиция меню" Margin="0,16,0,4" />
		<ComboBox x:Name="ItemBox" Height="32" DisplayMemberPath="Name" SelectedValuePath="MenuItemID" VerticalContentAlignment="Center" />
		<TextBlock Text="Группа" Margin="0,12,0,4" />
		<TextBox x:Name="GroupBox" Height="32" Padding="6,0" VerticalContentAlignment="Center" />
		<TextBlock Text="Значение" Margin="0,12,0,4" />
		<TextBox x:Name="NameBox" Height="32" Padding="6,0" VerticalContentAlignment="Center" />
		<TextBlock Text="Надбавка к цене" Margin="0,12,0,4" />
		<TextBox x:Name="PriceBox" Height="32" Padding="6,0" VerticalContentAlignment="Center" />
		<TextBlock x:Name="ErrorText" Foreground="#B3261E" TextWrapping="Wrap" Margin="0,14,0,0" Visibility="Collapsed" />
		<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
			<Button Content="Сохранить" Width="110" Height="34" IsDefault="True" Click="Save_Click" />
			<Button Content="Отмена" Width="110" Height="34" Margin="10,0,0,0" IsCancel="True" />
		</StackPanel>
	</StackPanel>
</Window>
