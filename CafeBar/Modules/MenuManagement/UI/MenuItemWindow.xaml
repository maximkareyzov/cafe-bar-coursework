<Window x:Class="CafeBar.Modules.MenuManagement.UI.MenuItemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Позиция меню" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#F5F6F8"
        FocusManager.FocusedElement="{Binding ElementName=NameBox}">
	<StackPanel Margin="28,24">
		<TextBlock x:Name="HeaderText" FontSize="22" FontWeight="SemiBold" />
		<TextBlock Text="Категория" Margin="0,16,0,4" />
		<ComboBox x:Name="CategoryBox" Height="32" DisplayMemberPath="Name" SelectedValuePath="CategoryID" VerticalContentAlignment="Center" />
		<TextBlock Text="Название" Margin="0,12,0,4" />
		<TextBox x:Name="NameBox" Height="32" Padding="6,0" VerticalContentAlignment="Center" />
		<TextBlock Text="Цена" Margin="0,12,0,4" />
		<TextBox x:Name="PriceBox" Height="32" Padding="6,0" VerticalContentAlignment="Center" />
		<TextBlock Text="Единица измерения" Margin="0,12,0,4" />
		<TextBox x:Name="UnitBox" Height="32" Padding="6,0" VerticalContentAlignment="Center" />
		<TextBlock Text="Описание" Margin="0,12,0,4" />
		<TextBox x:Name="DescriptionBox" Height="64" Padding="6,4" TextWrapping="Wrap" AcceptsReturn="True" />
		<CheckBox x:Name="AvailableBox" Content="Доступна для заказа" Margin="0,14,0,0" />
		<TextBlock x:Name="ErrorText" Foreground="#B3261E" TextWrapping="Wrap" Margin="0,14,0,0" Visibility="Collapsed" />
		<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
			<Button Content="Сохранить" Width="110" Height="34" IsDefault="True" Click="Save_Click" />
			<Button Content="Отмена" Width="110" Height="34" Margin="10,0,0,0" IsCancel="True" />
		</StackPanel>
	</StackPanel>
</Window>
