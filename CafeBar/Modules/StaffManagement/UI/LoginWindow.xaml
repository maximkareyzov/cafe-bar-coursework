<Window x:Class="CafeBar.Modules.StaffManagement.UI.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Кафе-бар" Width="380" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="#F5F6F8"
        FocusManager.FocusedElement="{Binding ElementName=LoginBox}">
    <StackPanel Margin="28,24">
        <TextBlock Text="Вход в систему" FontSize="22" FontWeight="SemiBold" />
        <TextBlock Text="Логин" Margin="0,18,0,4" />
        <TextBox x:Name="LoginBox" Height="32" Padding="6,0" VerticalContentAlignment="Center" />
        <TextBlock Text="Пароль" Margin="0,12,0,4" />
        <PasswordBox x:Name="PasswordInput" Height="32" Padding="6,0" VerticalContentAlignment="Center" />
        <TextBlock x:Name="ErrorText" Foreground="#B3261E" TextWrapping="Wrap" Margin="0,14,0,0" Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Войти" Width="110" Height="34" IsDefault="True" Click="SignIn_Click" />
            <Button Content="Закрыть" Width="110" Height="34" Margin="10,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
