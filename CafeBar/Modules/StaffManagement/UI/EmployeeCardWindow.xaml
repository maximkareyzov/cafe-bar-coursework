<Window x:Class="CafeBar.Modules.StaffManagement.UI.EmployeeCardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CafeBar.Modules.StaffManagement.UI"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=local:EmployeeCardViewModel}"
        Title="{Binding Title}" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#F5F6F8"
        FocusManager.FocusedElement="{Binding ElementName=FullNameBox}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,12,0,4" />
        </Style>
        <Style x:Key="FieldInput" TargetType="Control">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>
    <StackPanel Margin="28,24">
        <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" />
        <TextBlock Text="{Binding Hint}" Foreground="#555E6B" TextWrapping="Wrap" Margin="0,8,0,4" />

        <TextBlock Style="{StaticResource FieldLabel}" Text="ФИО" />
        <TextBox x:Name="FullNameBox" Style="{StaticResource FieldInput}" Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Style="{StaticResource FieldLabel}" Text="Должность (роль)" />
        <ComboBox Style="{StaticResource FieldInput}" ItemsSource="{Binding Roles}" SelectedItem="{Binding Role}" IsEnabled="{Binding CanChooseRole}" />

        <TextBlock Style="{StaticResource FieldLabel}" Text="Логин" />
        <TextBox Style="{StaticResource FieldInput}" Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Style="{StaticResource FieldLabel}" Text="Процент от продаж" />
        <TextBox Style="{StaticResource FieldInput}" Text="{Binding SalesPercent, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Style="{StaticResource FieldLabel}" Text="Пароль" />
        <PasswordBox x:Name="PasswordInput" Style="{StaticResource FieldInput}" />

        <TextBlock Style="{StaticResource FieldLabel}" Text="Повтор пароля" />
        <PasswordBox x:Name="PasswordRepeat" Style="{StaticResource FieldInput}" />

        <TextBlock Text="{Binding ErrorMessage}" Foreground="#B3261E" TextWrapping="Wrap" Margin="0,14,0,0"
                   Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibility}}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Сохранить" Width="110" Height="34" IsDefault="True" Click="Save_Click" />
            <Button Content="Отмена" Width="110" Height="34" Margin="10,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
